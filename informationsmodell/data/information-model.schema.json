          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "instanceRef": {
          "$ref": "#/$defs/id"
        },
        "planRef": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
