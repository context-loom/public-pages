            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "planRef": {
          "$ref": "#/$defs/id"
        },
        "specificationRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "methodRef": {
          "$ref": "#/$defs/id"
        },
        "resourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "stage": {
          "enum": [
            "as-built",
            "postprocessed",
            "final"
          ]
        },
        "openItems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
